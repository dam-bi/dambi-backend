
@baseUrl = http://localhost:8080

### USER role 테스트용 계정
@name = admin
@email = admin@exam.com
@password = password123!
@phone = 010-1234-5678
@role = USER

### ADMIN role 테스트용
@adminEmail = admin@email.com
@adminPW = qwer1234

### 회원가입 성공
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "name": "{{name}}",
  "email": "{{email}}",
  "password": "{{password}}",
  "phone": "{{phone}}",
  "role": "{{role}}"
}

> {%
    client.test("회원가입은 200과 실패사유를 반환한다. ", () => {
        client.assert(response.status === 200, `예상 상태: 200, 실제 상태: ${response.status}`);
        client.assert(response.body.message, "에러 발생. ");
    });
    client.global.set("message", response.body.message);
%}

### 비로그인 사용자는 인증이 필요한 로그아웃 URL에 접근할 수 없다.
POST {{baseUrl}}/api/auth/logout

> {%
    client.test("비로그인 로그아웃 요청은 401을 반환한다", () => {
        client.assert(response.status === 401, `예상 상태: 401, 실제 상태: ${response.status}`);
    });
%}

### 로그인 후 Access Token을 이후 요청에 사용할 전역 변수로 저장한다.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("로그인은 200과 Access Token을 반환한다", () => {
        client.assert(response.status === 200, `예상 상태: 200, 실제 상태: ${response.status}`);
        client.assert(response.body.accessToken, "Access Token이 없습니다.");
    });
    client.global.set("accessToken", response.body.accessToken);
%}

### admin용 계정 로그인
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPW}}"
}

> {%
    client.test("로그인은 200과 Access Token을 반환한다", () => {
        client.assert(response.status === 200, `예상 상태: 200, 실제 상태: ${response.status}`);
        client.assert(response.body.accessToken, "Access Token이 없습니다.");
    });
    client.global.set("accessToken", response.body.accessToken);
%}


### 유효한 Access Token으로 현재 사용자 정보를 확인한다.
POST {{baseUrl}}/api/auth/check
Authorization: Bearer {{accessToken}}

> {%
    client.test("사용자 정보 확인은 200과 사용자 정보를 반환한다", () => {
        client.assert(response.status === 200, `예상 상태: 200, 실제 상태: ${response.status}`);
        client.assert(response.body.name, "사용자 이름이 없습니다.");
        client.assert(response.body.email === "{{email}}", "로그인한 사용자 이메일이 아닙니다.");
    });
%}

### Access Token 없이 사용자 정보를 확인할 수 없다.
POST {{baseUrl}}/api/auth/check

> {%
    client.test("토큰 없는 사용자 정보 확인은 401을 반환한다", () => {
        client.assert(response.status === 401, `예상 상태: 401, 실제 상태: ${response.status}`);
    });
%}

### 형식이 잘못된 Access Token으로 사용자 정보를 확인할 수 없다.
POST {{baseUrl}}/api/auth/check
Authorization: Bearer invalid.access.token

> {%
    client.test("잘못된 토큰의 사용자 정보 확인은 401을 반환한다", () => {
        client.assert(response.status === 401, `예상 상태: 401, 실제 상태: ${response.status}`);
    });
%}

### 로그인 요청에서 발급받은 Access Token이 만료된 뒤 사용자 정보를 확인할 수 없다.
POST {{baseUrl}}/api/auth/check
Authorization: Bearer {{accessToken}}

> {%
    client.test("만료된 토큰의 사용자 정보 확인은 401을 반환한다", () => {
        client.assert(response.status === 401, `예상 상태: 401, 실제 상태: ${response.status}`);
    });
%}

### Access Token 만료를 가정해 Refresh Token 쿠키로 Access Token을 재발급받는다.
POST {{baseUrl}}/api/auth/refresh

> {%
    client.test("토큰 재발급은 200과 새 Access Token을 반환한다", () => {
        client.assert(response.status === 200, `예상 상태: 200, 실제 상태: ${response.status}`);
        client.assert(response.body.accessToken, "재발급된 Access Token이 없습니다.");
    });
    client.global.set("accessToken", response.body.accessToken);
%}

### 재발급된 Access Token으로 로그아웃하고 Refresh Token 쿠키가 만료됐는지 확인한다.
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{accessToken}}

> {%
    client.test("로그아웃은 200과 Refresh Token 쿠키 만료를 반환한다", () => {
        client.assert(response.status === 200, `예상 상태: 200, 실제 상태: ${response.status}`);
        client.assert(response.headers.valueOf("Set-Cookie").includes("Max-Age=0"), "Refresh Token 쿠키가 만료되지 않았습니다.");
    });
%}

### 로그아웃 뒤에는 Refresh Token이 삭제되어 재발급할 수 없다.
POST {{baseUrl}}/api/auth/refresh

> {%
    client.test("로그아웃 뒤 토큰 재발급은 401을 반환한다", () => {
        client.assert(response.status === 401, `예상 상태: 401, 실제 상태: ${response.status}`);
    });
%}

### 현재 구현은 Access Token 블랙리스트가 없어 만료 전 Access Token은 로그아웃 뒤에도 인증된다.
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{accessToken}}

> {%
    client.test("로그아웃 뒤에도 만료 전 Access Token은 200을 반환한다", () => {
        client.assert(response.status === 200, `예상 상태: 200, 실제 상태: ${response.status}`);
    });
%}

### admin/user 접근 테스트: /api/admin에 user role이 접근하는지 확인.
POST {{baseUrl}}/api/admin/
Authorization: Bearer {{accessToken}}

> {%
    client.test("ADMIN 계정이면 테스트용 string 문자열을 받는다.", () => {
        client.assert(response.status === 200, `예상 상태: 200, 실제 상태: ${response.status}`);
    });
%}